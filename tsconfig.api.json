{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Muss zu dem passen, womit Vercel die Funktionen uebersetzt: nodenext.
       Mit "bundler" waren extensionslose Importe hier gruen und bei Vercel
       rot (TS2835), und die Funktion stuerzte im Betrieb ab. Relative Importe
       brauchen deshalb die .js-Endung, auch wenn die Datei .ts heisst. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api", "src/data/setups.ts"]
}
